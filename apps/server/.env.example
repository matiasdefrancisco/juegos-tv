# Puerto del servidor (por defecto 3001)
PORT=3001

# Orígenes permitidos, separados por coma.
# Vacío = acepta cualquiera, que es lo práctico en red local (los celulares entran por IP).
# En producción conviene limitarlo al dominio del frontend:
# ALLOWED_ORIGINS=https://juegos-tv.web.app,https://juegos-tv.firebaseapp.com
ALLOWED_ORIGINS=

# (Opcional) Service account de Firebase Admin para persistir estadísticas.
# Requiere instalar firebase-admin y descomentar el bloque en src/firestore.ts
# FIREBASE_SERVICE_ACCOUNT_KEY={"type": "service_account", "project_id": "juegos-tv", ...}
